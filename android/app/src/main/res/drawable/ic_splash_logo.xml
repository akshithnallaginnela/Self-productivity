    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- Group scaled and centered to fill 288x288 splash icon canvas -->
    <group
        android:translateX="16"
        android:translateY="16"
        android:scaleX="0.5"
        android:scaleY="0.5">

        <!-- Outer Hexagonal Shield with Beveled Chamfers -->
        <path
