                    android:startX="206"
                    android:startY="274"
                    android:endX="306"
                    android:endY="412"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFFBEB" />
                    <item android:offset="0.5" android:color="#F59E0B" />
                    <item android:offset="1.0" android:color="#D97706" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Sovereign Inner Ember Crystal Facets -->
        <path
            android:pathData="M256,290 L292,332 L256,396 Z"
            android:fillColor="#F59E0B" />
        <path
            android:pathData="M256,290 L220,332 L256,396 Z"
