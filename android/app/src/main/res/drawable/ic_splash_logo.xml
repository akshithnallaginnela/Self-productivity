            android:fillColor="#161820"
            android:strokeWidth="12"
            android:strokeLineJoin="round"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="60"
                    android:startY="36"
                    android:endX="452"
                    android:endY="476"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FDE68A" />
                    <item android:offset="0.25" android:color="#D97706" />
                    <item android:offset="0.7" android:color="#78350F" />
                    <item android:offset="1.0" android:color="#F59E0B" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Subtle Shield Inset Rim -->
        <path
            android:pathData="M256,58 L432,136 L432,308 L256,448 L80,308 L80,136 Z"
            android:strokeWidth="2"
            android:strokeColor="#55F59E0B"
            android:strokeLineJoin="round" />

