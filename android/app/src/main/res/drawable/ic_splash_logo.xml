                    <item android:offset="1.0" android:color="#D97706" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Layer 1: Right Wing - Primary Upper Feathers -->
        <path
            android:pathData="M256,160 L404,108 L428,180 L332,208 L412,236 L308,268 L380,308 L256,380 Z">
