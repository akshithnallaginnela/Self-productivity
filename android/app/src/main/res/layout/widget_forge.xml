<?xml version="1.0" encoding="utf-8"?>
<!-- Freelance Forge 2x2. Placeholders are zeroed; ForgeWidgetProvider overwrites them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_forge_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_forge_label"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widgetOnSurfaceVariant" />

        <TextView
            android:id="@+id/widget_forge_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_pace_empty"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widgetOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_forge_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_forge_month"
            android:textSize="10sp"
            android:textColor="@color/widgetOnSurfaceVariant" />

        <TextView
            android:id="@+id/widget_forge_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_amount_empty"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widgetOnSurface"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_forge_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_goal_empty"
        android:textSize="9sp"
        android:textColor="@color/widgetOnSurfaceVariant" />
</LinearLayout>
