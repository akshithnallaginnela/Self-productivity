<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_tertiary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HABITS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#51643F" />

        <TextView
            android:id="@+id/widget_habit_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3/9"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1D1B20" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_habit_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="33%"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1D1B20" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_habit_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3-Minute Cold Shower"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#1D1B20"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
