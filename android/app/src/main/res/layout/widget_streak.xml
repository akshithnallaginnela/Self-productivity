<?xml version="1.0" encoding="utf-8"?>
<!--
    Sobriety Shield 4x2.

    The literal values below are the placeholders shown for the instant between
    a widget being dropped on the home screen and its first onUpdate. They are
    therefore ZEROED, never demo data — StreakWidgetProvider overwrites every
    one of them from SharedPreferences.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg_amber">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_streak_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_emoji_eagle"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_streak_label"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widgetOnAmberContainer" />

            <TextView
                android:id="@+id/widget_warrior_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_rank_empty"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widgetOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_btn_sos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/widget_sos"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widgetOnErrorContainer"
            android:background="@color/widgetErrorContainer"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:contentDescription="@string/widget_sos_description" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/widget_streak_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_zero"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="@color/widgetOnSurface"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_days_sober"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/widgetOnAmberContainer"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_streak_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_streak_empty"
                android:textSize="11sp"
                android:textColor="@color/widgetOnSurfaceVariant"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_streak_flame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_emoji_flame"
            android:textSize="32sp" />
    </LinearLayout>
</LinearLayout>
